pipeline {
  agent any
  stages {
    stage('Checkout'){ steps { checkout scm } }

    stage('Deploy'){
      steps {
        dir('deploy') {
          sh '''
            docker compose pull || true
            docker compose up -d
          '''
        }
      }
    }

    stage('Health'){
      steps {
        sh 'curl -sSf http://localhost:8090 > /dev/null || (docker compose -f deploy/docker-compose.yml ps && docker compose -f deploy/docker-compose.yml logs --no-color nocodb && false)'
      }
    }
  }
  post {
    success { echo 'NocoDB is up at http://localhost:8090 ✅' }
  }
}
